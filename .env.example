# Railway: use a token scoped to the dedicated demo workspace only
RAILWAY_API_TOKEN=
RAILWAY_WORKSPACE_ID=
# Controller database
DATABASE_URL=postgres://switchyard:switchyard@localhost:5432/switchyard
# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Webhook receiver: sent by Railway as a custom header value
WEBHOOK_SHARED_SECRET=
