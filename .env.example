# Copy to .env (gitignored) and fill in. Never commit real values.
# See docs/engineering/local-dev.md.

# --- Railway ----------------------------------------------------------------
# API token scoped to the dedicated demo workspace ONLY (CLAUDE.md hard rule).
# Needed for the spikes and live adapter tests (LIVE_RAILWAY=1); not for unit tests.
RAILWAY_API_TOKEN=
# ID of that demo workspace. Every Railway mutation is restricted to it.
RAILWAY_WORKSPACE_ID=

# --- Controller database ----------------------------------------------------
# Matches the postgres service in compose.yaml. Local-only credentials, not a secret.
DATABASE_URL=postgres://switchyard:switchyard@localhost:5432/switchyard

# --- Temporal ---------------------------------------------------------------
# Local: the dev server in compose.yaml (Web UI: http://localhost:8233); leave the API key empty.
# Deployed: Temporal Cloud (ADR-0009). Address <namespace>.<account>.tmprl.cloud:7233,
# namespace <namespace>.<account>, API key from the Cloud UI. Never commit or log the key.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# --- Webhook receiver (M2) --------------------------------------------------
# Random value Railway sends in a custom header; the receiver rejects requests
# without it (ADR-0010). Generate with: openssl rand -hex 32
WEBHOOK_SHARED_SECRET=
